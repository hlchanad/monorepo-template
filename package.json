{
  "name": "monorepo-template",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "deploy": "turbo run build --filter=!frontend && serverless deploy",
    "deploy:dev": "npm run deploy -- --stage dev",
    "deploy:prod": "npm run deploy -- --stage prod",
    "deploy:e2e": "AWS_ENDPOINT_URL=http://localhost:4567 npx serverless deploy:localstack --stage e2e",
    "e2e:start": "docker compose -p monorepo-template-e2e -f docker-compose.e2e.yml up -d",
    "e2e:stop": "docker compose -p monorepo-template-e2e -f docker-compose.e2e.yml down -v --remove-orphans && rm -rf .localstack_e2e"
  },
  "devDependencies": {
    "serverless": "^4.1.0",
    "serverless-localstack": "^1.4.0",
    "serverless-offline": "^14.5.0",
    "serverless-scriptable-plugin": "^1.3.1",
    "turbo": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "npm@10.8.2"
}
